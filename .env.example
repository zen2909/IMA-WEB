# Salin berkas ini jadi .env, lalu sesuaikan nilainya.
# .env tidak ikut ke repo karena bisa memuat rahasia.

# Koneksi database SQLite. Relatif terhadap folder proyek.
DATABASE_URL="file:./dev.db"

# Kunci penandatanganan session JWT. WAJIB diganti sebelum deploy:
# selama nilai ini diketahui orang, semua akun bisa login.
# Buat nilai acak minimal 32 karakter dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter-sebelum-production"